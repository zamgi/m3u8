    <Compile Include="..\..\m3u8.client\infrastructure\DefaultConnectionLimitSaver.cs" Link="[-= m3u8.client =-]\infrastructure\DefaultConnectionLimitSaver.cs" />

    <Compile Include="..\..\m3u8.client\client__v2\i_m3u8_client.cs" Link="[-= m3u8.client =-]\client__v2\i_m3u8_client.cs" />
    <Compile Include="..\..\m3u8.client\client__v2\m3u8_file_t.cs" Link="[-= m3u8.client =-]\client__v2\m3u8_file_t.cs" />
    <Compile Include="..\..\m3u8.client\client__v2\m3u8_client_base.cs" Link="[-= m3u8.client =-]\client__v2\m3u8_client_base.cs" />
    <Compile Include="..\..\m3u8.client\client__v2\m3u8_client__with_HttpClient.cs" Link="[-= m3u8.client =-]\client__v2\m3u8_client__with_HttpClient.cs" />
    <Compile Include="..\..\m3u8.client\client__v2\m3u8_client__with_HttpInvoker.cs" Link="[-= m3u8.client =-]\client__v2\m3u8_client__with_HttpInvoker.cs" />
    <Compile Include="..\..\m3u8.client\client__v2\m3u8_client_factory.cs" Link="[-= m3u8.client =-]\client__v2\m3u8_client_factory.cs" />
    <Compile Include="..\..\m3u8.client\client__v2\m3u8_processor.cs" Link="[-= m3u8.client =-]\client__v2\m3u8_processor.cs" />
